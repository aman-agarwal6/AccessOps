FROM python:3.13-slim-bookworm@sha256:88310c082760d93ac7c74d579e95e53a4ab6ea52dd8901abc61a103daf488ac4
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app:/app/backend
WORKDIR /app
COPY backend/requirements-dev.lock /tmp/requirements-dev.lock
RUN pip install --no-cache-dir --only-binary=:all: --require-hashes -r /tmp/requirements-dev.lock && useradd --uid 10001 --create-home accessops
COPY backend/ /app/backend/
COPY integrations/ /app/integrations/
USER 10001
WORKDIR /app/backend
CMD ["python", "-m", "pytest", "-q", "--tb=short", "-p", "no:cacheprovider", "--junitxml=/tmp/postgresql-tests.xml"]
